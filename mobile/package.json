{
  "name": "arctester-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:android:release": "cd android && ./gradlew assembleRelease --no-daemon",
    "prebuild:android": "CI=1 expo prebuild --platform android --no-install"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.3",
    "expo": "~54.0.0",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "expo-crypto": "~15.0.7",
    "expo-sqlite": "~16.0.9",
    "@react-native-community/netinfo": "11.4.1",
    "expo-font": "14.0.12",
    "expo-system-ui": "~6.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "vitest": "^2.0.5"
  },
  "overrides": {
    "expo-font": "14.0.12"
  }
}
