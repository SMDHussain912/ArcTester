// SQLite has NO enum type and NO array type, so:
// - difficulty/source are plain validated Strings (Zod enforces the values in code)
// - options are stored as a JSON string; Zod enforces "exactly 4 non-empty strings"
// questionHash is a UNIQUE normalized hash (lowercase, trimmed, collapsed spaces)
// so duplicates are blocked at the database level, not just in code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Subject {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  topics    Topic[]
  questions Question[]
}

model Topic {
  id        Int        @id @default(autoincrement())
  name      String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId Int
  questions Question[]

  @@unique([subjectId, name])
}

model Question {
  id           Int       @id @default(autoincrement())
  subject      Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId    Int
  topic        Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicId      Int?
  text         String
  // JSON string of exactly 4 non-empty option strings (validated by Zod).
  options      String
  correctIndex Int
  explanation  String    @default("")
  source       String    @default("")
  difficulty   String    @default("medium")
  questionHash String    @unique
  createdAt    DateTime  @default(now())
  answers      AttemptAnswer[]
  stat         Stat?

  @@index([subjectId])
}

model Attempt {
  id        Int             @id @default(autoincrement())
  mode      String          @default("mock")
  startedAt DateTime        @default(now())
  finishedAt DateTime?
  answers   AttemptAnswer[]
}

model AttemptAnswer {
  id         Int      @id @default(autoincrement())
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId  Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int
  chosen     Int?
  isCorrect  Boolean

  @@index([attemptId])
  @@index([questionId])
}

model Stat {
  id         Int      @id @default(autoincrement())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int      @unique
  seen       Int      @default(0)
  wrong      Int      @default(0)
  lastSeen   DateTime?
}
