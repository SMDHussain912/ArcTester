// PostgreSQL is the primary application database. Difficulty/source remain validated strings,
// and options remain JSON text so the API can preserve a stable import/export format.
// questionHash is a UNIQUE normalized hash, blocking duplicates at the database level.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subject {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  topics    Topic[]
  questions Question[]
  pathUnits PathUnit[]
}

model Topic {
  id        Int        @id @default(autoincrement())
  name      String
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId Int
  questions Question[]
  pathUnits PathUnit[]

  @@unique([subjectId, name])
}

model Question {
  id           Int       @id @default(autoincrement())
  subject      Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId    Int
  topic        Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  topicId      Int?
  text         String
  questionType String   @default("mcq")
  promptData   String   @default("{}")
  answerData   String   @default("{}")
  // JSON-encoded options; empty for non-choice questions.
  options      String
  correctIndex Int
  explanation  String    @default("")
  source       String    @default("")
  difficulty   String    @default("medium")
  reviewStatus String    @default("DRAFT")
  questionHash String    @unique
  createdAt    DateTime  @default(now())
  answers      AttemptAnswer[]
  stats        Stat[]
  examSnapshots ExamVersionQuestion[]
  lessonLinks LessonQuestion[]
  pathAnswers PathAnswer[]
  reviews UserQuestionReview[]
  @@index([subjectId])
  @@index([reviewStatus, subjectId])
}

model Attempt {
  id         Int             @id @default(autoincrement())
  mode       String          @default("mock")
  startedAt  DateTime        @default(now())
  deadline   DateTime?
  finishedAt DateTime?
  expired    Boolean         @default(false)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  answers    AttemptAnswer[]
  @@index([userId])
}

model User {
  id                 Int          @id @default(autoincrement())
  email              String       @unique
  passwordHash       String
  role               String       @default("STUDENT")
  accessStatus        String       @default("APPROVED")
  fullName           String?
  collegeName         String?
  collegeCode         String?
  postalPin           String?
  branchName          String?
  branchCode          String?
  // Incremented on logout to invalidate previously issued cookie and bearer JWTs.
  sessionVersion     Int          @default(0)
  createdAt          DateTime     @default(now())
  attempts           Attempt[]
  stats              Stat[]
  devices            Device[]
  invitationsCreated Invitation[] @relation("InvitationCreator")
  examsCreated       Exam[]       @relation("ExamCreator")
  assignments        ExamAssignment[] @relation("StudentAssignments")
  assignmentsCreated ExamAssignment[] @relation("AssignmentCreator")
  announcementsCreated Announcement[] @relation("AnnouncementCreator")
  announcementViews AnnouncementView[]
  notifications StudentNotification[]
  notificationPreferences StudentNotificationPreference?
  examSessions      ExamSession[]
  examSessionEvents ExamSessionEvent[] @relation("ExamSessionEventActor")
  lessonProgress UserLessonProgress[]
  unitTestProgress UserUnitTestProgress[]
  pathAnswers PathAnswer[]
  gamification UserGamification?
  xpEvents XpLedger[]
  gamificationDays GamificationDay[]
  questionReviews UserQuestionReview[]
  badges UserBadge[]
  lessonDrafts LessonDraft[]
  uploadedLessonAudio LessonAudioAsset[]
  createdLessonVersions LessonVersion[]
  privateQuestions StudentPrivateQuestion[]
  practiceSets StudentPracticeSet[]
  practiceRuns StudentPracticeRun[]
  mcpKeys StudentMcpKey[]
  adminMcpKeys AdminMcpKey[]
  adminMcpAuditLogs AdminMcpAuditLog[]
  modelDatasets ModelDataset[]
  modelTrainingJobs ModelTrainingJob[]
  modelRegistryAudits ModelRegistryAudit[]
  modelEvaluations ModelEvaluation[]

  @@index([collegeName])
  @@index([branchName])
  @@index([role, accessStatus])
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdById Int

  @@index([email, expiresAt])
  @@index([createdById])

}

model Device {
  id            String    @id @default(cuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  deviceName    String
  platform      String
  fingerprint   String
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  revokedAt     DateTime?

  @@unique([userId, fingerprint])
  @@index([userId, revokedAt])
}

// Exam content is versioned. Each version stores immutable question snapshots so
// later edits to the shared question bank cannot change an assigned exam.
model Exam {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  status      String   @default("DRAFT")
  createdBy   User     @relation("ExamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  versions    ExamVersion[]

  @@index([createdById, status])
}

model ExamVersion {
  id               String                 @id @default(cuid())
  exam             Exam                   @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId           String
  version          Int
  instructions     String                 @default("")
  durationMinutes  Int
  shuffleQuestions Boolean                @default(false)
  shuffleOptions   Boolean                @default(false)
  // Integrity policy for this exam version. OFF disables all violation
  // detection; BASIC logs violations for review; STRICT can auto-terminate.
  integrityLevel   String                 @default("BASIC")
  // When true, the client must present a secure client (SEB / locked-down
  // Android / Electron kiosk) to start the exam.
  requireSecureClient Boolean            @default(false)
  // Maximum accumulated violation weight before the session is flagged.
  maxViolations    Int                    @default(10)
  // When true, the server terminates the session once maxViolations is reached.
  autoTerminate    Boolean                @default(false)
  // SEB config keys used to verify SEB request-hash headers.
  sebKeys          String[]
  publishedAt      DateTime?
  createdAt        DateTime               @default(now())
  questions        ExamVersionQuestion[]
  assignments      ExamAssignment[]

  @@unique([examId, version])
  @@index([examId, publishedAt])
}

model ExamVersionQuestion {
  id              String       @id @default(cuid())
  examVersion     ExamVersion  @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  examVersionId   String
  sourceQuestion  Question?    @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)
  sourceQuestionId Int?
  position        Int
  subject         String
  topic           String?
  text            String
  options         String
  correctIndex    Int
  explanation     String       @default("")
  marks           Float        @default(1)
  negativeMarks   Float        @default(0)
  createdAt       DateTime     @default(now())

  @@unique([examVersionId, position])
  @@index([sourceQuestionId])
  submissionAnswers ExamSubmissionAnswer[]
  sessionAnswers   ExamSessionAnswer[]
}

model ExamAssignment {
  id             String       @id @default(cuid())
  examVersion    ExamVersion  @relation(fields: [examVersionId], references: [id], onDelete: Restrict)
  examVersionId  String
  student        User         @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  studentId      Int
  assignedBy     User         @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedById   Int
  assignedAt     DateTime     @default(now())
  availableFrom  DateTime?
  dueAt          DateTime?
  status         String       @default("ASSIGNED")
  submission     ExamSubmission?
  session        ExamSession?

  @@unique([examVersionId, studentId])
  @@index([studentId, status])
  @@index([assignedById])
}

model ExamSubmission {
  id              String                 @id @default(cuid())
  assignment      ExamAssignment         @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  assignmentId    String                 @unique
  attemptUuid     String                 @unique
  startedAt       DateTime
  submittedAt     DateTime
  receivedAt      DateTime               @default(now())
  status          String                 @default("RECEIVED")
  score           Float?
  maximumScore    Float?
  answers         ExamSubmissionAnswer[]

  @@index([receivedAt, status])
}

model ExamSubmissionAnswer {
  id                 String               @id @default(cuid())
  submission         ExamSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId       String
  examQuestion       ExamVersionQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Restrict)
  examQuestionId     String
  selectedIndex      Int?
  isCorrect          Boolean
  awardedMarks       Float

  @@unique([submissionId, examQuestionId])
  @@index([examQuestionId])
}

model ExamSession {
  id                String             @id @default(cuid())
  assignment        ExamAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId      String             @unique
  student           User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId         Int
  status            String             @default("NOT_STARTED")
  startedAt         DateTime?
  lastHeartbeatAt   DateTime?
  lastActivityAt    DateTime?
  pausedAt          DateTime?
  pausedDurationMs  Int                @default(0)
  answersRevision   Int                @default(0)
  endedAt           DateTime?
  heartbeatCount    Int                @default(0)
  focusLossCount    Int                @default(0)
  disconnectCount   Int                @default(0)
  // Integrity tracking
  violationCount    Int                @default(0)
  integrityFlagged  Boolean            @default(false)
  clientKind        String?
  deviceId          String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime           @default(now())
  events            ExamSessionEvent[]
  answers           ExamSessionAnswer[]

  @@index([status, lastHeartbeatAt])
  @@index([studentId, status])
  @@index([deviceId])
}

model ExamSessionEvent {
  id        String      @id @default(cuid())
  session   ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  actor     User?       @relation("ExamSessionEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   Int?
  type      String
  detail    String      @default("")
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@index([actorId])
}

model ExamSessionAnswer {
  id             String              @id @default(cuid())
  session        ExamSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId      String
  examQuestion   ExamVersionQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Restrict)
  examQuestionId String
  selectedIndex  Int?
  updatedAt      DateTime            @updatedAt

  @@unique([sessionId, examQuestionId])
  @@index([examQuestionId])
}

model AttemptAnswer {
  id         Int      @id @default(autoincrement())
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId  Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionId Int
  chosen            Int?
  isCorrect         Boolean
  subjectSnapshot   String   @default("")
  topicSnapshot     String?
  difficultySnapshot String  @default("medium")
  textSnapshot      String   @default("")
  optionsSnapshot   String   @default("[]")
  correctIndexSnapshot Int   @default(0)
  explanationSnapshot String @default("")
  questionTypeSnapshot String @default("mcq")
  promptDataSnapshot String @default("{}")
  answerDataSnapshot String @default("{}")
  responseSnapshot String @default("null")

  @@index([attemptId])
  @@index([questionId])
}

model Stat {
  id         Int      @id @default(autoincrement())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  seen       Int      @default(0)
  wrong      Int      @default(0)
  lastSeen   DateTime?

  // One stat row per (user, question) pair.
  @@unique([userId, questionId])
  @@index([questionId])
}


model Announcement {
  id          String             @id @default(cuid())
  title       String
  message     String
  startsAt    DateTime           @default(now())
  expiresAt   DateTime?
  createdAt   DateTime           @default(now())
  createdBy   User               @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdById Int
  views       AnnouncementView[]

  @@index([startsAt, expiresAt])
  @@index([createdById])
}

model AnnouncementView {
  id             String       @id @default(cuid())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  announcementId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  seenAt         DateTime     @default(now())
  acknowledgedAt DateTime?

  @@unique([announcementId, userId])
  @@index([userId, seenAt])
}


model StudentNotificationPreference {
  id              String   @id @default(cuid())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int      @unique
  examAssignments Boolean  @default(true)
  examResults     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StudentNotification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  kind      String
  title     String
  message   String
  href      String
  dedupeKey String   @unique
  createdAt DateTime @default(now())
  readAt    DateTime?
  expiresAt DateTime?

  @@index([userId, readAt, createdAt])
  @@index([expiresAt])
}

// Model registry and evaluation records. These models must remain represented in
// the Prisma schema as well as the SQL migrations so generated clients expose them.
model IntegrityFlag {
  id              String   @id @default(cuid())
  assignmentId    String
  studentIdA      Int
  studentIdB      Int
  studentEmailA   String
  studentEmailB   String
  sharedWrong     Int
  totalWrongA     Int
  totalWrongB     Int
  threshold       Int
  sameIp          Boolean
  fastAnswers     Boolean
  flaggedAt       DateTime @default(now())
  dismissed       Boolean  @default(false)
  dismissedAt     DateTime?
  dismissedBy     Int?

  @@index([assignmentId])
  @@index([studentIdA, studentIdB])
}


model StudyMaterial {
  id             String   @id @default(cuid())
  uploadedById   Int?
  title          String
  description    String   @default("")
  subject        String
  topic          String   @default("")
  url            String   @default("")
  fileName       String   @default("")
  mimeType       String   @default("")
  sizeBytes      Int      @default(0)
  contentBase64  String   @default("")
  status         String   @default("DRAFT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, subject, title])
  @@index([uploadedById, createdAt])
}



model PathUnit {
  id        Int      @id @default(autoincrement())
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId Int
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  topicId   Int
  position  Int
  title     String
  lessons   PathLesson[]
  testProgress UserUnitTestProgress[]
  answers PathAnswer[]

  @@unique([subjectId, topicId])
  @@unique([subjectId, position])
  @@index([subjectId])
}

model PathLesson {
  id        Int      @id @default(autoincrement())
  unit      PathUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId    Int
  position  Int
  title     String
  questions LessonQuestion[]
  progress  UserLessonProgress[]
  answers   PathAnswer[]

  @@unique([unitId, position])
  @@index([unitId])
}

model LessonQuestion {
  id         Int        @id @default(autoincrement())
  lesson     PathLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId   Int
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int
  position   Int

  @@unique([lessonId, position])
  @@unique([questionId])
  @@index([lessonId])
}

model UserLessonProgress {
  id           Int        @id @default(autoincrement())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  lesson       PathLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId     Int
  completedAt  DateTime?
  bestScorePct Int        @default(0)
  attempts     Int        @default(0)

  @@unique([userId, lessonId])
  @@index([userId])
}

model UserUnitTestProgress {
  id           Int       @id @default(autoincrement())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       Int
  unit         PathUnit  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId       Int
  passedAt     DateTime?
  bestScorePct Int       @default(0)
  attempts     Int       @default(0)

  @@unique([userId, unitId])
  @@index([userId])
}

model PathAnswer {
  id         Int        @id @default(autoincrement())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId Int
  lesson     PathLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId   Int?
  unit       PathUnit?  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId     Int?
  scopeKey   String
  response   String     @default("null")
  isCorrect  Boolean    @default(false)
  updatedAt  DateTime   @updatedAt

  @@unique([userId, scopeKey, questionId])
  @@index([userId, lessonId])
  @@index([userId, unitId])
}


// Student reward state. Dates are stored as UTC calendar-day boundaries.
model UserGamification {
  id                   Int      @id @default(autoincrement())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               Int      @unique
  totalXp              Int      @default(0)
  xpBalance            Int      @default(0)
  currentStreak        Int      @default(0)
  longestStreak        Int      @default(0)
  lastActivityDate     DateTime? @db.Date
  dailyGoalXp         Int      @default(50)
  streakFreezeInventory Int     @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model XpLedger {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  eventKey  String
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  @@unique([userId, eventKey])
  @@index([userId, createdAt])
}

model GamificationDay {
  id                  Int      @id @default(autoincrement())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              Int
  date                DateTime @db.Date
  xpEarned            Int      @default(0)
  lessonsCompleted    Int      @default(0)
  unitTestsPassed     Int      @default(0)
  practiceTestsDone   Int      @default(0)
  goalReachedAt       DateTime?
  freezeUsed          Boolean  @default(false)

  @@unique([userId, date])
  @@index([userId, date])
}


// Per-user spaced repetition state. The interval is rule-based and never uses ML.
model UserQuestionReview {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId      Int
  lastReviewedAt  DateTime?
  nextReviewAt    DateTime @default(now())
  intervalDays    Int      @default(0)
  repetitions     Int      @default(0)
  reviewCount     Int      @default(0)
  lastWasCorrect Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, questionId])
  @@index([userId, nextReviewAt])
  @@index([userId, lastReviewedAt])
}

model UserBadge {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  badgeKey   String
  unlockedAt DateTime @default(now())

  @@unique([userId, badgeKey])
  @@index([userId, unlockedAt])
}

// AI-generated lesson drafts are private until an admin reviews and publishes them.
model LessonDraft {
  id             String   @id @default(cuid())
  createdBy       User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById     Int
  title           String
  subject         String
  topic           String
  sourceTitle     String
  sourceText      String
  scriptJson      String
  storyboardJson  String
  provider        String
  model           String
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, updatedAt])
  @@index([createdById])
  audioAssets LessonAudioAsset[]

  versions        LessonVersion[]
  activeVersion   LessonVersion? @relation("ActiveLessonVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  activeVersionId String? @unique
}



model LessonVersion {
  id                   String   @id @default(cuid())
  lessonDraft          LessonDraft @relation(fields: [lessonDraftId], references: [id], onDelete: Cascade)
  lessonDraftId        String
  version              Int
  packageSchemaVersion Int
  manifestKey          String?
  manifestSha256       String?
  manifestSizeBytes    Int?
  status               String   @default("UPLOADING")
  validationJson       String   @default("{}")
  createdBy            User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdById          Int
  createdAt            DateTime @default(now())
  verifiedAt           DateTime?
  publishedAt          DateTime?
  assets               LessonVersionAsset[]
  activeFor            LessonDraft? @relation("ActiveLessonVersion")

  @@unique([lessonDraftId, version])
  @@index([lessonDraftId, status, version])
}

model LessonVersionAsset {
  id             String   @id @default(cuid())
  lessonVersion  LessonVersion @relation(fields: [lessonVersionId], references: [id], onDelete: Cascade)
  lessonVersionId String
  assetId        String
  sceneId        String?
  role           String
  objectKey      String   @unique
  mimeType       String
  sizeBytes      Int
  sha256         String
  durationMs     Int?
  locale         String?
  narrationHash  String?
  createdAt      DateTime @default(now())

  @@unique([lessonVersionId, assetId])
  @@index([lessonVersionId, sceneId])
}

// Audio bytes live in private object storage; PostgreSQL stores only metadata and narration fingerprint.
model LessonAudioAsset {
  id             String      @id @default(cuid())
  lessonDraft    LessonDraft @relation(fields: [lessonDraftId], references: [id], onDelete: Cascade)
  lessonDraftId  String
  uploadedBy     User        @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedById   Int
  sceneIndex     Int
  storagePath    String      @unique
  mimeType       String
  sizeBytes      Int
  narrationHash  String
  voice          String      @default("unknown")
  model          String      @default("unknown")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([lessonDraftId, sceneIndex])
  @@index([lessonDraftId, narrationHash])
}

/// Student-owned practice content is isolated from the public/admin ECET bank.
model StudentPrivateQuestion {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  subject     String
  topic       String   @default("General")
  text        String
  options     Json     @default("[]")
  correctIndex Int     @default(0)
  explanation String   @default("")
  difficulty  String   @default("medium")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([userId, subject, topic])
  @@index([userId, updatedAt])
}

model StudentPracticeSet {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  title       String
  description String   @default("")
  durationMinutes Int  @default(20)
  questions   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  runs        StudentPracticeRun[]
  @@index([userId, updatedAt])
}

model StudentPracticeRun {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int
  practiceSet      StudentPracticeSet? @relation(fields: [practiceSetId], references: [id], onDelete: SetNull)
  practiceSetId    String?
  titleSnapshot    String
  totalQuestions   Int
  answeredCount   Int
  correctCount    Int
  percentage      Float
  answers         Json
  completedAt     DateTime @default(now())
  @@index([userId, completedAt])
  @@index([practiceSetId])
}

model StudentMcpKey {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  name        String
  keyHash     String   @unique
  scopes      String[]
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  @@index([userId, revokedAt])
}

model AdminMcpKey {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  name        String
  keyHash     String   @unique
  scopes      String[]
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  @@index([userId, revokedAt])
}

model AdminMcpAuditLog {
  id          String   @id @default(cuid())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId     Int
  tool        String
  success     Boolean
  summary     String   @default("")
  createdAt   DateTime @default(now())
  @@index([actorId, createdAt])
  @@index([createdAt])
}


/// Versioned ML model artifacts. The artifact JSON stores a URI and integrity metadata,
/// never model binaries or credentials.
model RegisteredModel {
  id                String   @id
  modelId            String
  version            Int
  algorithm           String
  task                String
  dataset             String
  trainingDatasetId   String?
  artifactJson        String
  isActive            Boolean  @default(false)
  createdAt           DateTime @default(now())
  activatedAt         DateTime?
  @@unique([modelId, version])
  @@index([modelId, isActive])
  @@index([createdAt])
}

/// Admin action trail for model registration, evaluation and activation.
model ModelRegistryAudit {
  id        String   @id
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId   Int?
  modelId   String
  version   Int
  action    String
  details   String   @default("{}")
  createdAt DateTime @default(now())
  @@index([modelId, version, createdAt])
  @@index([actorId, createdAt])
}

/// Immutable dataset snapshots with explicit provenance and a content fingerprint.
model ModelDataset {
  id                 String   @id
  createdBy           User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById         Int?
  name                String
  task                String
  targetColumn        String   @default("target")
  featureSchemaJson   String
  samplesJson         String
  rowCount            Int
  sourceDescription  String
  sourceAttested      Boolean  @default(false)
  datasetKind         String   @default("synthetic")
  fingerprint         String   @unique
  createdAt            DateTime @default(now())
  trainingJobs        ModelTrainingJob[]
  @@index([name, createdAt])
  @@index([createdById, createdAt])
}

/// Training is asynchronous. A queued job is not reported as trained until a worker
/// completes it and writes a result.
model ModelTrainingJob {
  id              String   @id
  dataset         ModelDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict)
  datasetId       String
  createdBy       User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById     Int?
  modelId         String
  seed            Int      @default(42)
  epochs          Int      @default(80)
  batchSize       Int      @default(32)
  status          String   @default("QUEUED")
  progress        Int      @default(0)
  errorMessage    String   @default("")
  workerId        String   @default("")
  leaseExpiresAt  DateTime?
  resultJson      String   @default("{}")
  createdAt       DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime @updatedAt
  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@index([datasetId, createdAt])
}

/// Evaluation records require an explicitly designated verification dataset.
model ModelEvaluation {
  id                  String   @id
  actor               User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId             Int?
  modelId             String
  candidateVersion    Int
  baselineVersion     Int
  datasetId           String   @default("")
  evaluationDataset   String
  datasetFingerprint  String
  sampleCount         Int
  metricsJson         String
  status              String
  evaluatedAt         DateTime @default(now())
  @@index([modelId, candidateVersion, evaluatedAt])
  @@index([actorId, evaluatedAt])
}

/// Aggregated, non-identifying model input drift counters.
model ModelDriftBucket {
  id          String   @id
  modelId     String
  version     Int
  featureName String
  bucket      String
  periodStart DateTime
  count       Int      @default(0)
  @@unique([modelId, version, featureName, bucket, periodStart])
  @@index([modelId, version, periodStart])
}

