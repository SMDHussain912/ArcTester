DATABASE_URL="postgresql://arctester:change-this-password@localhost:5432/arctester?schema=public"
PORT=4000
# Generate production secrets with: openssl rand -hex 32
JWT_SECRET=
CORS_ORIGINS=
# Keep Lax for same-site/local deployments. For Vercel + Render, set None (requires HTTPS).
COOKIE_SAME_SITE=Lax
# For a cross-site frontend, add its exact origin, e.g. https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app

# Server-only lesson generation provider configuration (never expose to web/mobile builds)
NVIDIA_API_KEY=
NVIDIA_LESSON_MODEL=
# Optional OpenAI-compatible API base URL; defaults to NVIDIA hosted API
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
