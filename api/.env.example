DATABASE_URL="file:./dev.db"
PORT=4000
# Generate a production secret with: openssl rand -hex 32
# Leave blank for local development; production refuses missing or weak secrets.
JWT_SECRET=
CORS_ORIGINS=
# Keep Lax for same-site/local deployments. For Vercel + Render, set None (requires HTTPS).
COOKIE_SAME_SITE=Lax
# For a cross-site frontend, add its exact origin, e.g. https://your-app.vercel.app
# CORS_ORIGINS=https://your-app.vercel.app
