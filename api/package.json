{
  "name": "ecet-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--require dotenv/config' tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src tests prisma/seed.ts prisma/baseQuestions.ts prisma/bootstrapAdmin.ts",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "import:questions": "tsx prisma/seed.ts",
    "admin:bootstrap": "tsx prisma/bootstrapAdmin.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "zod": "^4.6.7",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.12",
    "eslint": "^9.4.0",
    "prisma": "^5.17.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
