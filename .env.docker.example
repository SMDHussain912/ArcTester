# PostgreSQL container credentials. Use a URL-safe password for DATABASE_URL interpolation.
POSTGRES_USER=arctester
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=arctester

# Required: replace with a long random secret before starting the containers.
JWT_SECRET=replace-this-with-a-long-random-secret

# Browser-visible API URL. For LAN access, use your computer's LAN IP.
VITE_API_URL=http://localhost:4000

# Exact browser origins allowed by the API, comma-separated.
CORS_ORIGINS=http://localhost:3000
COOKIE_SAME_SITE=Lax

# Optional Answer Intelligence providers. Keep all keys on the API server only.
# External OpenAI-compatible provider (OpenAI, compatible gateways, etc.).
ARCTESTER_AI_PROVIDER=openai-compatible
ARCTESTER_AI_BASE_URL=https://api.openai.com/v1
ARCTESTER_AI_API_KEY=
ARCTESTER_AI_MODEL=

# Or select Anthropic Claude instead:
# ARCTESTER_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ARCTESTER_ANTHROPIC_MODEL=

# Optional local OpenAI-compatible server (Ollama or llama.cpp).
# Leave ARCTESTER_LOCAL_AI_MODEL empty to disable local network calls.
ARCTESTER_LOCAL_AI_BASE_URL=http://host.docker.internal:11434/v1
ARCTESTER_LOCAL_AI_MODEL=
ARCTESTER_LOCAL_AI_API_KEY=
