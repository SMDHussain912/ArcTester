# PostgreSQL container credentials. Use a URL-safe password for DATABASE_URL interpolation.
POSTGRES_USER=arctester
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
POSTGRES_DB=arctester

# Required: replace with a long random secret before starting the containers.
JWT_SECRET=replace-this-with-a-long-random-secret

# Browser-visible API URL. For LAN access, use your computer's LAN IP.
VITE_API_URL=http://localhost:4000

# Exact browser origins allowed by the API, comma-separated.
CORS_ORIGINS=http://localhost:3000
COOKIE_SAME_SITE=Lax
